# 原程序与本地工作目录不进入版本管理。
*.apk
dungeon_village_1/work/
dungeon_village_1/DungeonVillageEXE/

# 只保留通用解析/提取工具的标准目录；专题探针和交付核对留本地。
dungeon_village_1/tools/*/
!dungeon_village_1/tools/include/
!dungeon_village_1/tools/src/
!dungeon_village_1/tools/tests/
!dungeon_village_1/tools/scripts/
dungeon_village_1/tools/work_archive_paths.*
dungeon_village_1/tools/scripts/*audit*
dungeon_village_1/tools/scripts/*verify*
dungeon_village_1/tools/scripts/*check*
dungeon_village_1/tools/scripts/catalogue_unlocks.mjs
dungeon_village_1/tools/scripts/character_job_unlocks.cjs
dungeon_village_1/tools/scripts/steam_task_selection.cjs

# 机器核对产物、交付指纹和已退休草稿不归档。
dungeon_village_1/verification/**/*.json
dungeon_village_1/verification/.gitattributes
dungeon_village_1/data/CATALOGUE_UNLOCK_INDEX.json
dungeon_village_1/data/CHARACTER_JOB_UNLOCK_INDEX.json
dungeon_village_1/stages/in-progress/village-activity/

