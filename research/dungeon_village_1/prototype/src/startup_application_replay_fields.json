{
  "format": "AVRAPP01",
  "semantics": 6,
  "boundary": "complete-outer-round-v1",
  "fields": [
    {
      "name": "paths_",
      "type": "StartupApplicationPaths",
      "policy": "rebind: 显式research/work隔离路径；不读取快照旧路径"
    },
    {
      "name": "storage_",
      "type": "StartupApplicationStorageSnapshot",
      "policy": "save/rebind: records完整系统2及槽位引用闭包；missing/digest在新根发布后重绑"
    },
    {
      "name": "draft_",
      "type": "StartupTitleDraft",
      "policy": "save: village/main_character{name,sex,custom_name}/slot"
    },
    {
      "name": "random_",
      "type": "ref::WorldRandomStream",
      "policy": "save: WorldRandomSnapshot完整引擎/磁带/游标/模式"
    },
    {
      "name": "mode_",
      "type": "StartupApplicationMode",
      "policy": "save: logic或title_presentation"
    },
    {
      "name": "page_",
      "type": "StartupApplicationPage",
      "policy": "save: 应用页面枚举"
    },
    {
      "name": "record_page_",
      "type": "int",
      "policy": "save: 纪录页0或1"
    },
    {
      "name": "decorations_",
      "type": "std::vector<int>",
      "policy": "save: 原序定义ID名单"
    },
    {
      "name": "requests_",
      "type": "std::uint64_t",
      "policy": "save: 显式纪录请求序号"
    },
    {
      "name": "handoff_",
      "type": "std::optional<ref::WorldRandomSnapshot>",
      "policy": "save: 可选历史交接完整随机快照"
    },
    {
      "name": "world_",
      "type": "std::optional<StartupWorldRuntimeSession>",
      "policy": "save: 可选AVRSAVE1完整Session与原序审计历史"
    },
    {
      "name": "clear_rows_",
      "type": "std::optional<StartupClearScoreRows>",
      "policy": "save: 可选六行count/score"
    },
    {
      "name": "clear_",
      "type": "std::optional<StartupClearScorePageState>",
      "policy": "save: 可选stage/counter/row/sum/captured_high_score/finished/new_record/trophy"
    },
    {
      "name": "clear_id_",
      "type": "std::optional<std::uint64_t>",
      "policy": "save: 可选稳定raw17页ID"
    },
    {
      "name": "error_",
      "type": "std::string",
      "policy": "require-empty: 仅健康应用可捕获；恢复不重演旧错误"
    },
    {
      "name": "title_",
      "type": "StartupTitlePresentation",
      "policy": "save: StartupTitlePresentation完整计数和20槽；logic模式必须为初始态"
    },
    {
      "name": "title_menu_",
      "type": "StartupTitleMenuState",
      "policy": "save: 完整根菜单、raw20、询问、外部子页及未消费返回载荷"
    },
    {
      "name": "audio_requests_",
      "type": "std::vector<StartupAudioRequest>",
      "policy": "require-empty: 一次性音频请求必须已消费，恢复为空"
    },
    {
      "name": "cleanup_pending_",
      "type": "bool",
      "policy": "rebind: 源环境文件清理债务不跨环境恢复，新根置false"
    }
  ],
  "nested": [
    {
      "name": "StartupApplicationStorageSnapshot",
      "fields": [
        {
          "name": "records",
          "type": "StartupSystemRecords",
          "policy": "save: 完整系统2、四条目录、引用及未知可选段"
        },
        {
          "name": "missing",
          "type": "bool",
          "policy": "rebind: 新根已发布system，恒false；不参与行为摘要"
        },
        {
          "name": "digest",
          "type": "std::string",
          "policy": "rebind: 发布system原始字节的SHA256；不信任源路径观察"
        }
      ]
    },
    {
      "name": "StartupTitleCatalogStamp",
      "fields": [
        {
          "name": "revision",
          "type": "std::uint64_t",
          "policy": "save: uint64目录修订"
        },
        {
          "name": "digest",
          "type": "std::array<std::uint8_t, 32>",
          "policy": "save: 32字节系统文件身份"
        }
      ]
    },
    {
      "name": "StartupTitleSaveMenu",
      "fields": [
        {
          "name": "id",
          "type": "std::uint64_t",
          "policy": "save: uint64稳定页ID"
        },
        {
          "name": "parent",
          "type": "std::uint64_t",
          "policy": "save: uint64父页ID"
        },
        {
          "name": "slot",
          "type": "int",
          "policy": "save: int32栏位"
        },
        {
          "name": "selection",
          "type": "int",
          "policy": "save: int32当前行"
        },
        {
          "name": "frame",
          "type": "int",
          "policy": "save: int32帧计数"
        },
        {
          "name": "result",
          "type": "int",
          "policy": "save: int32返回值"
        },
        {
          "name": "returned",
          "type": "bool",
          "policy": "save: bool已返回位"
        },
        {
          "name": "catalog",
          "type": "std::optional<StartupTitleCatalogStamp>",
          "policy": "save: 可选目录修订与32字节身份"
        }
      ]
    },
    {
      "name": "StartupTitleConfirmation",
      "fields": [
        {
          "name": "id",
          "type": "std::uint64_t",
          "policy": "save: uint64稳定页ID"
        },
        {
          "name": "parent",
          "type": "std::uint64_t",
          "policy": "save: uint64父页ID"
        },
        {
          "name": "reason",
          "type": "StartupTitleConfirmationReason",
          "policy": "save: 重新开始或隐藏"
        },
        {
          "name": "selection",
          "type": "int",
          "policy": "save: int32当前行"
        },
        {
          "name": "result",
          "type": "int",
          "policy": "save: int32返回值"
        },
        {
          "name": "returned",
          "type": "bool",
          "policy": "save: bool已返回位"
        }
      ]
    },
    {
      "name": "StartupTitleExternal",
      "fields": [
        {
          "name": "id",
          "type": "std::uint64_t",
          "policy": "save: uint64稳定页ID"
        },
        {
          "name": "parent",
          "type": "std::uint64_t",
          "policy": "save: uint64父页ID"
        },
        {
          "name": "kind",
          "type": "StartupTitleExternalPage",
          "policy": "save: 纪录或配置"
        },
        {
          "name": "returned",
          "type": "bool",
          "policy": "save: bool已返回位"
        },
        {
          "name": "completed",
          "type": "bool",
          "policy": "save: bool配置完成位"
        }
      ]
    },
    {
      "name": "StartupTitleMenuState",
      "fields": [
        {
          "name": "mode",
          "type": "StartupTitleRootMode",
          "policy": "save: 根菜单或两栏"
        },
        {
          "name": "selection",
          "type": "int",
          "policy": "save: int32根菜单行"
        },
        {
          "name": "row",
          "type": "int",
          "policy": "save: int32两栏行"
        },
        {
          "name": "root_id",
          "type": "std::uint64_t",
          "policy": "save: uint64根页ID"
        },
        {
          "name": "next_id",
          "type": "std::uint64_t",
          "policy": "save: uint64下一页ID"
        },
        {
          "name": "save_menu",
          "type": "std::optional<StartupTitleSaveMenu>",
          "policy": "save: 可选raw20完整载荷"
        },
        {
          "name": "confirmation",
          "type": "std::optional<StartupTitleConfirmation>",
          "policy": "save: 可选询问完整载荷"
        },
        {
          "name": "external",
          "type": "std::optional<StartupTitleExternal>",
          "policy": "save: 可选外部子页完整载荷"
        }
      ]
    },
    {
      "name": "StartupTitleSlot",
      "fields": [
        {
          "name": "active",
          "type": "int",
          "policy": "save: int32活动位"
        },
        {
          "name": "definition",
          "type": "int",
          "policy": "save: int32人物定义ID"
        },
        {
          "name": "x",
          "type": "int",
          "policy": "save: int32横坐标"
        },
        {
          "name": "y",
          "type": "int",
          "policy": "save: int32纵坐标；inactive仍参与排序"
        },
        {
          "name": "direction",
          "type": "int",
          "policy": "save: int32方向"
        },
        {
          "name": "age",
          "type": "int",
          "policy": "save: int32步龄；退休和重用仍保留"
        }
      ]
    },
    {
      "name": "StartupTitlePresentation",
      "fields": [
        {
          "name": "l",
          "type": "int",
          "policy": "save: int32入场计数，饱和递增"
        },
        {
          "name": "f132f",
          "type": "int",
          "policy": "save: int32标题计数，回卷递增"
        },
        {
          "name": "s",
          "type": "int",
          "policy": "save: int32出生间隔"
        },
        {
          "name": "t",
          "type": "int",
          "policy": "save: int32间隔内计数"
        },
        {
          "name": "slots",
          "type": "std::array<StartupTitleSlot, 20>",
          "policy": "save: 原序20槽StartupTitleSlot，含inactive全部字段"
        }
      ]
    }
  ]
}
